# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# EAS submit credentials (never commit — supplied out-of-band)
google-service-account.json

# Firebase Android client config (2026-08-31, FCM push credentials) -- not a
# private key like the service account above, but kept out of git anyway per
# the owner's own call: uploaded to EAS instead as a file-type environment
# variable (GOOGLE_SERVICES_JSON), referenced via app.config.js's
# googleServicesFile fallback chain. A real local copy is still needed here
# for `expo start`/local builds -- supplied out-of-band, same as the file above.
google-services.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
