# PostgreSQL connection. Local dev default (db/docker-compose.yml):
DATABASE_URL=postgres://postgres:vr@localhost:5433/voteright
# Hosted Postgres (e.g. Neon): use the pooled connection string and keep sslmode=require:
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Admin-console auth (production): TOTP + signed sessions. Generate both with
#   node scripts/gen-admin-secret.mjs
# and enroll the printed otpauth:// URI in an authenticator app. Production
# fails closed if these are unset.
# ADMIN_TOTP_SECRET=
# ADMIN_SESSION_SECRET=

# Local-dev fallback only (used when ADMIN_TOTP_SECRET is unset and
# NODE_ENV != production): the value doubles as the sign-in code.
ADMIN_TOKEN=dev-admin

# Federal/state ingestion (D6, 2026-08-11). Free-tier read-only public-data
# keys — sign up at https://api.congress.gov/sign-up/ and
# https://openstates.org/api/register/.
CONGRESS_API_KEY=
OPENSTATES_API_KEY=

# Real production bug found live (2026-08-14): every server-action route's
# post-submit redirect used request.url's own origin to build the target,
# which behind this app's Apache reverse proxy (docs/DEPLOY.md) is the bare
# 127.0.0.1:3001 the Node process is bound to, not the real public domain
# -- Apache doesn't forward the original Host header to it. Every real user
# submitting any form (verify an address, second a proposal, vote, every
# admin action, ...) got redirected to http://localhost:3001/... instead of
# the real site. SITE_URL, when set, is used instead of the proxy-mangled
# request.url origin -- see lib/redirect.ts. Leave unset in local dev
# (request.url is already correct there, no proxy in front of it);
# REQUIRED in production.
# SITE_URL=https://voteright.dpimatrix.com

# Address predictive autocomplete on /verify (2026-08-14, owner-approved
# reversal of the earlier browser-native-only privacy decision — see
# lib/debates.ts). NEXT_PUBLIC_ because it's used client-side; safe to
# expose since the key itself is restricted (HTTP referrer + Places API
# (New) only) in Google Cloud Console, not a secret. Without it, the
# address field silently falls back to a plain text input -- verification
# itself is unaffected either way, since the Census geocoder remains the
# actual source of truth.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
